{% if site.bib_search %}
  <div class="publication-search">
    <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
    <label for="bibsearch" class="sr-only">Filter publications by title, author, or venue</label>
    <input
      type="search"
      id="bibsearch"
      spellcheck="false"
      autocomplete="off"
      class="search bibsearch-form-input"
      placeholder="Search by title, author, or venue"
      aria-describedby="bibsearch-status"
    >
    <p id="bibsearch-status" class="publication-search-status" role="status" aria-live="polite"></p>
  </div>
{% endif %}
