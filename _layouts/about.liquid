---
layout: default
---
<div class="home-page">
  <section class="intro" aria-labelledby="intro-title">
    <div class="intro-copy">
      <h1 id="intro-title">Chang <span class="preferred-name">(Chris)</span> Liu</h1>
      <p class="intro-role">Ph.D. student at Texas A&amp;M University</p>
      <p class="research-statement">Robot learning for reliable, <span class="keep-together">contact-rich</span> manipulation.</p>
      <div class="intro-bio">{{ content }}</div>
      <div class="profile-links" aria-label="Professional links">
        <a class="primary-link" href="{{ '/assets/pdf/Chang_Liu_CV.pdf' | relative_url }}">Download CV <span aria-hidden="true">&darr;</span></a>
        <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}">Google Scholar</a>
        <a href="https://github.com/{{ site.data.socials.github_username }}">GitHub</a>
        <a href="https://huggingface.co/{{ site.data.socials.huggingface_username }}">Hugging Face</a>
        <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}/">LinkedIn</a>
        <a href="mailto:{{ site.data.socials.email }}">Email</a>
      </div>
    </div>
    <figure class="intro-portrait">
      <picture>
        {% if site.imagemagick.enabled %}
          <source
            type="image/webp"
            srcset="{{ '/assets/img/prof_pic-480.webp' | relative_url }} 480w, {{ '/assets/img/prof_pic-800.webp' | relative_url }} 800w"
            sizes="(max-width: 650px) 104px, 255px"
          >
        {% endif %}
        <img
          src="{{ '/assets/img/prof_pic.jpg' | relative_url }}"
          alt="Chang (Chris) Liu outdoors in front of a historic building"
          width="768"
          height="1024"
          fetchpriority="high"
        >
      </picture>
      <figcaption>
        Control and Robotics Lab<br>
        College Station, Texas
      </figcaption>
    </figure>
  </section>

  <aside class="availability" aria-label="Research opportunities">
    <p><strong>Looking ahead.</strong> I'm seeking Summer 2027 research internships in robot learning and embodied AI.</p>
    <a href="mailto:{{ site.data.socials.email }}">Get in touch <span aria-hidden="true">&rarr;</span></a>
  </aside>

  <section class="home-section" aria-labelledby="research-title">
    <div class="section-heading">
      <h2 id="research-title">Research</h2>
      <a href="{{ '/research/' | relative_url }}">Explore my research <span aria-hidden="true">&rarr;</span></a>
    </div>
    <p class="section-intro">I work across policy learning, manipulation skills, and the systems that connect them to real robots.</p>
    <dl class="research-themes">
      <div>
        <dt>Learning from experience</dt>
        <dd>Using robot rollouts and human corrections to improve VLA policies through supervised fine-tuning.</dd>
      </div>
      <div>
        <dt>Skills for physical interaction</dt>
        <dd>Coordinating learned approach and recovery with structured skills for contact-rich disassembly.</dd>
      </div>
      <div>
        <dt>Systems that close the loop</dt>
        <dd>Building teleoperation, data collection, perception, and evaluation tools around real hardware.</dd>
      </div>
    </dl>
  </section>

  <section class="home-section" aria-labelledby="selected-work-title">
    <div class="section-heading">
      <h2 id="selected-work-title">Selected work</h2>
      <a href="{{ '/publications/' | relative_url }}">All publications <span aria-hidden="true">&rarr;</span></a>
    </div>
    {% include research_projects.liquid %}
  </section>

  <section class="home-section" aria-labelledby="news-title">
    <div class="section-heading">
      <h2 id="news-title">Recent news</h2>
      <a href="{{ '/news/' | relative_url }}">News archive <span aria-hidden="true">&rarr;</span></a>
    </div>
    {% include news.liquid limit=4 %}
  </section>

  <section class="contact-section" aria-labelledby="contact-title">
    <div>
      <h2 id="contact-title">Let's talk robots.</h2>
      <p>I'm interested in research collaborations on robot learning, human feedback, and reliable manipulation.</p>
    </div>
    <a href="mailto:{{ site.data.socials.email }}">
      {{- site.data.socials.email }}
      <span aria-hidden="true">&rarr;</span></a
    >
  </section>
</div>
