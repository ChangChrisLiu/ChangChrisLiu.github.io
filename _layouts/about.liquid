---
layout: default
---
<div class="home-page">
  <section class="personal-intro" aria-labelledby="intro-title">
    <div class="personal-bio">
      <h1 id="intro-title">Chang (Chris) Liu</h1>
      {{ content }}
      <div class="personal-links" aria-label="Professional links">
        <a href="mailto:{{ site.data.socials.email }}">Email</a>
        <a href="{{ '/assets/pdf/Chang_Liu_CV.pdf' | relative_url }}">CV</a>
        <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}">Google Scholar</a>
        <a href="https://github.com/{{ site.data.socials.github_username }}">GitHub</a>
        <a href="https://huggingface.co/{{ site.data.socials.huggingface_username }}">Hugging Face</a>
        <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}/">LinkedIn</a>
      </div>
      <p class="personal-availability">I'm looking for a research internship in summer 2027.</p>
    </div>
    <figure class="personal-portrait">
      <picture>
        {% if site.imagemagick.enabled %}
          <source
            type="image/webp"
            srcset="{{ '/assets/img/prof_pic-480.webp' | relative_url }} 480w, {{ '/assets/img/prof_pic-800.webp' | relative_url }} 800w"
            sizes="(max-width: 650px) 100px, 160px"
          >
        {% endif %}
        <img src="{{ '/assets/img/prof_pic.jpg' | relative_url }}" alt="Chang (Chris) Liu" width="768" height="1024" fetchpriority="high">
      </picture>
    </figure>
  </section>

  <section class="home-work" aria-labelledby="work-title">
    <div class="home-section-heading">
      <h2 id="work-title">Selected publications</h2>
      <a href="{{ '/publications/' | relative_url }}">All publications</a>
    </div>
    {% bibliography --template bib_home --query @*[homepage=true] --group_by none %}
  </section>

  <section class="home-updates" aria-labelledby="updates-title">
    <div class="home-section-heading">
      <h2 id="updates-title">News</h2>
      <a href="{{ '/news/' | relative_url }}">Archive</a>
    </div>
    <ol>
      <li>
        <time datetime="2026-10-13">Oct 2026</time>
        <p><a href="https://arxiv.org/abs/2610.19248">PACER</a> paper, project page and code are public.</p>
      </li>
      <li>
        <time datetime="2026-09-07">Sep 2026</time>
        <p>PACER accepted to CoRL 2026.</p>
      </li>
      <li>
        <time datetime="2026-03-10">Mar 2026</time>
        <p><a href="https://arxiv.org/abs/2603.11080">SELF-VLA</a> preprint released.</p>
      </li>
    </ol>
  </section>
</div>
